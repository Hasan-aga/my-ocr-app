OCR_API_KEY=replace-with-at-least-16-random-characters
# Engine selection
OCR_ENABLE_PADDLE=true
# OCR_DEFAULT_MODEL=
# When unset and PaddleOCR is enabled, the default is "paddle" (the local engine).
# Example: OCR_DEFAULT_MODEL=qwen-vl-ocr-2025-11-20

# Alibaba Cloud Model Studio (Qwen) - Singapore region
# OCR_QWEN_API_KEY=
# OCR_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# When OCR_QWEN_MODELS is empty, every model the key can access is auto-discovered
# from the provider's /models API at startup. Set it to restrict to a subset:
# OCR_QWEN_MODELS=qwen-vl-ocr-2025-11-20,qwen3.7-plus
# OCR_QWEN_TIMEOUT_SECONDS=60
# OCR_QWEN_MAX_RETRIES=3

OCR_MODEL_TIER=medium
# OCR_DET_MODEL_NAME=
# OCR_REC_MODEL_NAME=
OCR_PREPROCESS=none
OCR_MAX_UPLOAD_MB=15
OCR_MAX_IMAGE_PIXELS=50000000
OCR_MAX_SIDE=2000
OCR_DET_LIMIT_SIDE_LEN=960
OCR_DET_LIMIT_TYPE=max
OCR_DET_THRESH=0.3
OCR_DET_BOX_THRESH=0.6
OCR_DET_UNCLIP_RATIO=2.0
OCR_REC_SCORE_THRESH=0.0
OCR_CPU_THREADS=3
OCR_ENABLE_MKLDNN=true
OCR_WARMUP=true
OCR_USE_TEXTLINE_ORIENTATION=false
OCR_BUSY_TIMEOUT_SECONDS=1.0
OCR_DOCS_ENABLED=false